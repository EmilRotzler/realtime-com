# Build context is the repo root; keep it small and free of secrets

# Repo / tooling
.git
.gitignore
.vs
.vscode
.idea
docs
.docker-data
**/*.md

# Secrets and local env
.env
**/.env.local
**/.env.*.local
**/appsettings.*.local.json

# Docker files themselves
Dockerfile*
docker-compose*.yml
compose*.yml
.dockerignore

# Frontend build output / dependencies (rebuilt in the image)
**/node_modules
**/dist
**/coverage

# .NET build output (rebuilt in the image)
**/bin
**/obj
**/TestResults
**/*.user
