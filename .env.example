# Docker Compose environment for realtime-com.
# Copy to .env (gitignored) and adjust values for your machine:
#   cp .env.example .env
# Compose reads .env automatically from the folder it is run in.

# Compose project name (prefixes container, network and volume names)
COMPOSE_PROJECT_NAME=realtime-com

# ---------------------------------------------------------------------------
# Backend (.NET, back/)
# ---------------------------------------------------------------------------
# Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Development
# Port the app listens on inside the container
BACKEND_CONTAINER_PORT=8080
# Port exposed on the host machine
BACKEND_HOST_PORT=5000

# ---------------------------------------------------------------------------
# Frontend (Vue + Vite, front/)
# ---------------------------------------------------------------------------
# Port the frontend is served on inside the container
FRONTEND_CONTAINER_PORT=80
# Port exposed on the host machine
FRONTEND_HOST_PORT=8081
# Backend URL as seen from the browser. VITE_* values are baked in at build
# time, so pass this to the frontend image as a build arg.
VITE_API_URL=http://localhost:5000
